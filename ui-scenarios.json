{
  "scenarios": [
    {
      "name": "a checkout shows who has the item and survives a reload",
      "members": {
        "lead": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_equipment_checkout__equipment (id, name, category, status, created_by, created_at, updated_at) VALUES ('eq-ok', ?, 'av', 'available', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": [
            "Projector",
            "{{lead}}"
          ]
        },
        {
          "action": "open"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"equipment-row\"][data-equipment-id=\"eq-ok\"][data-equipment-status=\"available\"]"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"checkout-btn\"][data-equipment-id=\"eq-ok\"]"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"checkout-form\"]"
        },
        {
          "action": "select",
          "selector": "[data-testid=\"field-member\"]",
          "value": "{{lead}}"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"checkout-submit\"]"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"equipment-row\"][data-equipment-id=\"eq-ok\"][data-equipment-status=\"checked_out\"]",
          "text": "E2E equipment-checkout-lead"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"return-btn\"][data-equipment-id=\"eq-ok\"]"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"checkout-btn\"][data-equipment-id=\"eq-ok\"]",
          "count": 0
        },
        {
          "action": "reload"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"equipment-row\"][data-equipment-id=\"eq-ok\"][data-equipment-status=\"checked_out\"]",
          "text": "E2E equipment-checkout-lead"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"return-btn\"][data-equipment-id=\"eq-ok\"]"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"checkout-btn\"][data-equipment-id=\"eq-ok\"]",
          "count": 0
        }
      ]
    },
