{
  "id": "equipment-checkout",
  "contexts": ["household", "shared_space"],
  "name": "Equipment Checkout",
  "version": "1.0.0",
  "description": "The club's gear closet — an inventory of org-owned equipment, who has what checked out, due dates, and the full lending history per item.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["equipment", "inventory", "checkout", "lending", "club", "gear"],
  "icon": "🧰",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "add_equipment": {
      "title": "Add equipment to the inventory",
      "description": "Track a new item when another app's event fires — gear bought, donated, or returned to service.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Added by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "What it is",
          "required": true
        },
        "category": {
          "type": "text",
          "label": "Category",
          "default": "other",
          "options": ["camping", "sports", "av", "kitchen", "tools", "other"]
        },
        "notes": {
          "type": "text",
          "label": "Notes",
          "default": ""
        }
      },
      "dedupe": {
        "table": "equipment",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "equipment",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "category": ":category",
            "notes": ":notes",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "db_plaintext_columns": ["due_date"],
  "row_policies": {
    "equipment": {
      "kind": "adult_writable"
    },
    "checkouts": {
      "kind": "adult_writable"
    }
  },
  "member_references": {
    "equipment": { "column": "created_by", "on_removed": "keep" },
    "checkouts": [
      { "column": "member_id", "on_removed": "keep" },
      { "column": "recorded_by", "on_removed": "keep" }
    ]
  },
  "publishes": ["equipment.checked_out", "equipment.returned"],
  "publish_acls": {
    "equipment.checked_out": { "require_role": "member" },
    "equipment.returned": { "require_role": "member" }
  },
  "nav": { "label": "Gear" },
  "agenda": {
    "kind": "task",
    "label": "Gear due back",
    "source": {
      "kind": "sql",
      "query": "SELECT c.id AS id, e.name AS title, NULLIF(e.identifier, '') AS subtitle, c.due_date AS when_at, c.member_id AS member_id, 0 AS done FROM app_equipment_checkout__checkouts c JOIN app_equipment_checkout__equipment e ON e.id = c.equipment_id WHERE c.returned_at IS NULL AND c.due_date = :today ORDER BY c.checked_out_at LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_equipment_checkout__checkouts WHERE returned_at IS NULL AND due_date <> '' AND due_date < :today LIMIT 1"
    },
    "display": { "template": "badge", "count": "n", "label": "items overdue", "severity": "warn" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["equipment", "open_checkouts"]
  }
}
